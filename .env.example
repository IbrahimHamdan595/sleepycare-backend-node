# Copy to .env and fill in. DATABASE_URL, JWT_SECRET and FRONTEND_URL are required.

# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/sleepycare?schema=public

# Old MongoDB, only for the one-time `npm run db:import-mongo`
MONGODB_URI=
MONGODB_DB=sleepycare

# JWT
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRES_MINUTES=10080

# Admin account created by `npm run seed:admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# The storefront's address. It sends the reset and order emails and hosts the reset page.
FRONTEND_URL=http://localhost:3000
# A long random string, the same value as INTERNAL_API_SECRET in the frontend.
# Without it no emails are sent. Generate one with: openssl rand -hex 32
INTERNAL_API_SECRET=

# Cloudflare R2 image storage (optional; without it images are saved in the database as base64)
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# OAuth (currently disabled)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
APPLE_ISSUER=
APPLE_AUDIENCE=

PORT=8000
